--- !u!114 &71579830
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 71579828}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uD300SNOW \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\r\n\n\uD300SNOW(\u201D\uD300SNOW\u201D
    \uB610\uB294 \u201C\uAC1C\uBC1C\uD300\u201D\uC774\uB77C \uD568)\uB294 \uC774\uC6A9\uC790\uC758
    \u2018\uB3D9\uC758\uB97C \uAE30\uBC18\uC73C\uB85C \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC218\uC9D1 \xB7 \uC774\uC6A9 \uBC0F \uC81C\uACF5\u2019 \uD558\uACE0 \uC788\uC73C\uBA70,
    \u2018\uC774\uC6A9\uC790\uC758 \uAD8C\uB9AC(\uAC1C\uC778\uC815\uBCF4 \uC790\uAE30\uACB0\uC815\uAD8C)\uB97C
    \uC801\uADF9\uC801\uC73C\uB85C \uBCF4\uC7A5\u2019 \uD569\uB2C8\uB2E4.\r\n\r\n\r\n\uAC1C\uBC1C\uD300\uC740
    \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uB97C \uC704\uD574
    \u300C\uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95\u300D \uBC0F \uAD00\uACC4 \uBC95\uB839\uC744
    \uC900\uC218\uD558\uC5EC \uC801\uBC95\uD558\uAC8C \uAC1C\uC778\uC815\uBCF4\uB97C
    \uCC98\uB9AC\uD558\uACE0 \uC548\uC804\uD558\uAC8C \uAD00\uB9AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n\"\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\"\uC774\uB780
    \uC774\uC6A9\uC790\uC758 \uC18C\uC911\uD55C \uAC1C\uC778\uC815\uBCF4\uB97C \uBCF4\uD638\uD568\uC73C\uB85C\uC368
    \uC774\uC6A9\uC790\uAC00 \uC548\uC2EC\uD558\uACE0 \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD560
    \uC218 \uC788\uB3C4\uB85D \uD300SNOW\uAC00 \uC900\uC218\uD574\uC57C \uD560 \uC9C0\uCE68\uC744
    \uC758\uBBF8\uD569\uB2C8\uB2E4.\r\n\r\n\uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740
    \uD300SNOW\uC5D0\uC11C \uC11C\uBE44\uC2A4\uD558\uACE0 \uC788\uB294 \uAC8C\uC784\uC5D0
    \uC801\uC6A9\uB418\uBA70, \uB0B4\uC6A9 \uC911 \u2018\uD300SNOW\uAC00 \uC81C\uACF5\uD558\uB294
    \uC11C\uBE44\uC2A4\u2019\uB294 \uC704\uC758 \uBC94\uC704\uB97C \uC9C0\uCE6D\uD569\uB2C8\uB2E4.\r\n\r\n\r\n\r\n1.
    \uAC1C\uC778\uC815\uBCF4 \uC218\uC9D1\uD56D\uBAA9\r\n\uAC1C\uBC1C\uD300\uC740
    \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC744 \uC704\uD55C \uD544\uC694 \uCD5C\uC18C\uD55C\uC758
    \uAC1C\uC778\uC815\uBCF4\uB97C \uC218\uC9D1\uD569\uB2C8\uB2E4.\r\n\r\n\r\n[\uD68C\uC6D0
    \uAC00\uC785]\r\n\uD544\uC218: \uC774\uB984, \uC0DD\uB144\uC6D4\uC77C, \uC131\uBCC4,
    \uB0B4/\uC678\uAD6D\uC778, \uBCF8\uC778\uD655\uC778\uAC12(CI), \uD734\uB300\uD3F0
    \uBC88\uD638, \uC774\uB3D9\uD1B5\uC2E0\uC0AC\r\n\uC120\uD0DD: \uD559\uAD50 \uBC0F
    \uAE30\uAD00 \uC774\uBA54\uC77C \uACC4\uC815(\uC18C\uC18D \uC778\uC99D)\r\n\r\n[\uC18C\uC15C
    \uACC4\uC815 \uC5F0\uB3D9 - \uAD6C\uAE00, \uB124\uC774\uBC84, \uCE74\uCE74\uC624]\r\n\uC81C3\uC790
    \uC81C\uACF5\uC5D0 \uC758\uD55C \uC218\uC9D1(\uC81C\uACF5\uC790: \uAD6C\uAE00,
    \uB124\uC774\uBC84, \uCE74\uCE74\uC624)\r\n\r\n\uD544\uC218: \uC18C\uC15C \uACC4\uC815(\uB2C9\uB124\uC784/\uD504\uB85C\uD544
    \uC0AC\uC9C4), \uC5F0\uB77D\uCC98(\uC774\uBA54\uC77C \uB610\uB294 \uC804\uD654\uBC88\uD638)\r\n\uC120\uD0DD:
    \uBCF8\uC778\uD655\uC778 [\uC131\uBCC4, \uC774\uB984, \uC0DD\uB144\uC6D4\uC77C,
    \uC5F0\uACC4(CI)]\r\n\r\n[\uC790\uB3D9 \uC218\uC9D1 \uD56D\uBAA9]\r\n\uD544\uC218:
    IP\uC8FC\uC18C, \uCFE0\uD0A4, \uBC29\uBB38\uC77C\uC2DC \uBD88\uB7C9 \uC774\uC6A9
    \uAE30\uB85D \uB4F1\uC758 \uC11C\uBE44\uC2A4 \uC774\uC6A9\uAE30\uB85D, \uAE30\uAE30\uC815\uBCF4,
    \uC0AC\uC6A9\uC790 \uAE30\uAE30 \uC704\uCE58\uC815\uBCF4\r\n\r\n[\uC571 \uB0B4
    \uACB0\uC81C \uBC0F \uD658\uBD88]\r\n\uD544\uC218: \uD734\uB300\uD3F0 \uBC88\uD638,
    \uAC70\uC8FC\uC9C0 \uC8FC\uC18C, \uC6B0\uD3B8\uBC88\uD638, \uACC4\uC88C\uC815\uBCF4(\uC740\uD589\uBA85,
    \uC608\uAE08\uC8FC\uBA85, \uACC4\uC88C\uBC88\uD638), \uACB0\uC81C \uC815\uBCF4\r\n\r\n\r\n2.
    \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uBAA9\uC801\r\n\uAC1C\uBC1C\uD300\uC740
    \uB2E4\uC74C\uC758 \uBAA9\uC801\uC744 \uC704\uD558\uC5EC \uAC1C\uC778\uC815\uBCF4\uB97C
    \uCC98\uB9AC\uD569\uB2C8\uB2E4. \uCC98\uB9AC\uD558\uACE0 \uC788\uB294 \uAC1C\uC778\uC815\uBCF4\uB294
    \uB2E4\uC74C\uC758 \uBAA9\uC801 \uC774\uC678\uB85C\uB294 \uC774\uC6A9\uD558\uC9C0
    \uC54A\uC73C\uBA70, \uC774\uC6A9 \uBAA9\uC801\uC774 \uBCC0\uACBD\uB418\uB294
    \uACBD\uC6B0\u300C\uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95\u300D \uC81C18\uC870\uC5D0
    \uB530\uB77C \uBCC4\uB3C4\uC758 \uB3D9\uC758\uB97C \uBC1B\uB294 \uB4F1 \uD544\uC694\uD55C
    \uC870\uCE58\uB97C \uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n\uC774\uC6A9\uC790
    \uC2DD\uBCC4, \uAC00\uC785\uC758\uC0AC \uD655\uC778 \uBC0F \uAC00\uC785 \uD69F\uC218
    \uC81C\uD55C, \uBD88\uB7C9\uD68C\uC6D0\uC758 \uBD80\uC815\uD55C \uC774\uC6A9
    \uBC29\uC9C0\r\n\uC11C\uBE44\uC2A4 \uC774\uC6A9 \uACFC\uC815\uC5D0\uC11C \uC774\uC6A9\uC790\uC758
    \uBB38\uC758\uC0AC\uD56D\uC774\uB098 \uBD88\uB9CC\uCC98\uB9AC, \uACF5\uC9C0\uC0AC\uD56D
    \uC804\uB2EC\r\n\uC11C\uBE44\uC2A4 \uC81C\uACF5, \uC720\uB8CC \uC11C\uBE44\uC2A4
    \uAD6C\uB9E4 \uBC0F \uC774\uC6A9\uC744 \uD560 \uACBD\uC6B0 \uC694\uAE08 \uC815\uC0B0\r\n\uC2E0\uADDC\uC11C\uBE44\uC2A4
    \uAC1C\uBC1C \uBC0F \uC774\uBCA4\uD2B8 \uD589\uC0AC \uC2DC \uCC38\uC5EC\uAE30\uD68C\uB97C
    \uC54C\uB9AC\uAE30 \uC704\uD55C \uC804\uB2EC \uBC0F \uB9C8\uCF00\uD305 \uBC0F
    \uAD11\uACE0\r\n\uC11C\uBE44\uC2A4 \uC774\uC6A9\uAE30\uB85D\uACFC \uC811\uC18D
    \uBE48\uB3C4 \uBD84\uC11D, \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC5D0 \uB300\uD55C
    \uD1B5\uACC4\uB97C \uD1B5\uD55C \uB9DE\uCDA4\uD615 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uACFC
    \uC11C\uBE44\uC2A4 \uAC1C\uC120\r\n\uC774\uC6A9\uC790 \uAC1C\uC778\uC815\uBCF4\uBCF4\uD638\uB97C
    \uC704\uD55C \uC548\uC804\uD55C \uC774\uC6A9\uD658\uACBD \uAD6C\uCD95\r\n\uC704\uCE58
    \uAE30\uBC18 \uAC8C\uC784 \uB610\uB294 \uC11C\uBE44\uC2A4\uC5D0\uC11C\uC758 \uB9AC\uC18C\uC2A4
    \uBC0F \uC774\uBCA4\uD2B8 \uC81C\uACF5\r\n\r\n\r\n3. \uAC1C\uC778\uC815\uBCF4
    \uBCF4\uC720 \uBC0F \uC774\uC6A9 \uAE30\uAC04\r\n\uAC1C\uBC1C\uD300\uC740 \uC774\uC6A9\uC790\uAC00
    \uD68C\uC6D0\uAC00\uC785 \uBC0F \uC11C\uBE44\uC2A4 \uC774\uC6A9 \uC2DC \uB3D9\uC758\uBC1B\uC740
    \uAC1C\uC778\uC815\uBCF4 \uBCF4\uC720\xB7\uC774\uC6A9\uAE30\uAC04 \uB0B4\uC5D0\uC11C
    \uAC1C\uC778\uC815\uBCF4\uB97C \uCC98\uB9AC\uD569\uB2C8\uB2E4. \uC774\uC6A9\uC790\uAC00
    \uAC1C\uC778\uC815\uBCF4 \uC218\uC9D1\xB7\uC774\uC6A9\uC5D0 \uB300\uD55C \uB3D9\uC758\uB97C
    \uCCA0\uD68C\uD558\uB294 \uACBD\uC6B0, \uC218\uC9D1\xB7\uC774\uC6A9 \uBAA9\uC801\uC774
    \uB2EC\uC131\uB418\uAC70\uB098 \uAE30\uAC04\uC774 \uC885\uB8CC\uB418\uC5C8\uC744
    \uB54C \uD574\uB2F9 \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB294 \uC9C0\uCCB4\uC5C6\uC774
    \uD30C\uAE30\uD569\uB2C8\uB2E4.\r\n\r\n\r\n\uD68C\uC6D0\uD0C8\uD1F4\uB97C \uC694\uCCAD\uD560
    \uACBD\uC6B0 \uAC1C\uC778\uC815\uBCF4 \uB3C4\uC6A9 \uB4F1\uC73C\uB85C \uC778\uD55C
    \uC6D0\uCE58\uC54A\uB294 \uD68C\uC6D0\uD0C8\uD1F4 \uB4F1\uC5D0 \uB300\uBE44\uD558\uAE30
    \uC704\uD574 \uD68C\uC6D0\uD0C8\uD1F4 \uC694\uCCAD \uD6C4 7\uC77C\uAC04 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uBCF4\uC720\uD569\uB2C8\uB2E4. \uAC8C\uC784\uB370\uC774\uD130 \uC800\uC7A5\uBC94\uC704\uB294
    \uAC01 \uAC8C\uC784\uBCC4 \uC6B4\uC601\uC815\uCC45\uC744 \uB530\uB985\uB2C8\uB2E4.\r\n\r\n\r\n\uB2E4\uB9CC
    \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4 \uC911 \uBCF8\uC778\uD655\uC778\uAC12(CI)\uC740
    \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC5D0 \uD63C\uB780 \uBC0F \uBD80\uC815 \uC0AC\uC6A9
    \uBC29\uC9C0, \uBCF8\uC778\uD655\uC778\uC744 \uC704\uD574 15\uC77C\uAC04 \uAE30\uC874\uC758
    \uC800\uC7A5\uACF5\uAC04\uACFC \uAD6C\uBD84\uB41C \uBCC4\uB3C4\uC758 \uC800\uC7A5\uACF5\uAC04\uC5D0\uC11C
    \uC548\uC804\uD558\uAC8C \uC800\uC7A5\uB429\uB2C8\uB2E4.\r\n\r\n\r\n\uC11C\uBE44\uC2A4
    \uC774\uC6A9\uC81C\uD55C \uC0C1\uD0DC\uC778 \uACC4\uC815\uC758 \uBCF8\uC778\uD655\uC778\uAC12(CI)\uC740
    \uBD80\uC815\uC0AC\uC6A9\uC744 \uBC29\uC9C0\uD558\uAE30 \uC704\uD574 \uCD5C\uB300
    5\uB144\uAC04 \uBCF4\uAD00\uD558\uBA70, \uAE30\uC874\uC758 \uC800\uC7A5\uACF5\uAC04\uACFC
    \uAD6C\uBD84\uB41C \uBCC4\uB3C4\uC758 \uC800\uC7A5\uACF5\uAC04\uC5D0 \uC554\uD638\uD654\uD558\uC5EC
    \uC548\uC804\uD558\uAC8C \uC800\uC7A5\uB429\uB2C8\uB2E4.\r\n\r\n\r\n\uAD00\uACC4\uBC95\uB839\uC5D0
    \uB530\uB978 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uAD00\r\n\uAC1C\uBC1C\uD300\uC740
    \uAD00\uACC4 \uBC95\uB839\uC5D0 \uB530\uB77C \uC77C\uC815\uAE30\uAC04 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uBCF4\uAD00\uD569\uB2C8\uB2E4.\r\n\r\n\u300C\uC804\uC790\uC0C1\uAC70\uB798 \uB4F1\uC5D0\uC11C\uC758
    \uC18C\uBE44\uC790 \uBCF4\uD638\uC5D0 \uAD00\uD55C \uBC95\uB960\u300D\r\n\uACC4\uC57D
    \uB610\uB294 \uCCAD\uC57D\uCCA0\uD68C \uB4F1\uC5D0 \uAD00\uD55C \uAE30\uB85D
    : 5\uB144\r\n\uB300\uAE08\uACB0\uC81C, \uC7AC\uD654 \uB4F1\uC758 \uACF5\uAE09\uAE30\uB85D
    : 5\uB144\r\n\uC18C\uBE44\uC790 \uBD88\uB9CC \uB610\uB294 \uBD84\uC7C1\uCC98\uB9AC\uC5D0
    \uAD00\uD55C \uAE30\uB85D : 3\uB144\r\n\uD45C\uC2DC\xB7\uAD11\uACE0\uC5D0 \uAD00\uD55C
    \uAE30\uB85D : 6\uAC1C\uC6D4\r\n\u300C\uAD6D\uC138\uAE30\uBCF8\uBC95\u300D, \u300C\uBC95\uC778\uC138\uBC95\u300D\r\n\uC138\uBC95\uC774
    \uADDC\uC815\uD558\uB294 \uAC70\uB798\uC5D0 \uAD00\uD55C \uC7A5\uBD80 \uBC0F
    \uC99D\uBE59\uC11C\uB958 : 5\uB144\r\n\u300C\uC804\uC790\uAE08\uC735\uAC70\uB798\uBC95\u300D\r\n\uC804\uC790\uAE08\uC735
    \uAC70\uB798\uC5D0 \uAD00\uD55C \uAE30\uB85D : 5\uB144\r\n\u300C\uD1B5\uC2E0\uBE44\uBC00\uBCF4\uD638\uBC95\u300D\r\n\uC11C\uBE44\uC2A4
    \uC774\uC6A9\uAD00\uB828 \uAC1C\uC778\uC815\uBCF4(\uB85C\uADF8\uC778 \uAE30\uB85D)
    : 3\uAC1C\uC6D4\r\n\r\n\r\n4. \uAC1C\uC778\uC815\uBCF4 \uC81C3\uC790 \uC81C\uACF5\r\n\uAC1C\uBC1C\uD300\uC740
    \uAC1C\uC778\uC815\uBCF4\uC758 \uCC98\uB9AC\uBAA9\uC801\uC5D0\uC11C \uBA85\uC2DC\uD55C
    \uBC94\uC704 \uB0B4\uC5D0\uC11C\uB9CC \uCC98\uB9AC\uD558\uBA70, \uC774\uC6A9\uC790\uC758
    \uB3D9\uC758, \uBC95\uB960\uC5D0\uC11C \uD2B9\uBCC4\uD55C \uADDC\uC815 \uB4F1
    \uAD00\uB828 \uBC95\uB839\uC5D0 \uD574\uB2F9\uD558\uB294 \uACBD\uC6B0\uB9CC \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC81C3\uC790\uC5D0\uAC8C \uC81C\uACF5\uD558\uACE0 \uADF8 \uC774\uC678\uC5D0\uB294
    \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uC81C3\uC790\uC5D0\uAC8C
    \uC81C\uACF5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n\uAC1C\uBC1C\uD300\uC758
    \uAC1C\uC778\uC815\uBCF4 \uC81C3\uC790 \uC81C\uACF5\uB0B4\uC5ED\uC740 \uC544\uB798
    \uD45C\uC5D0\uC11C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC11C\uBE44\uC2A4\uBA85\t\uD68C\uC0AC\uBA85\t\uAC1C\uC778\uC815\uBCF4
    \uC81C\uACF5\uD56D\uBAA9\r\n\uC81C\uACF5\uD55C \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC0AC\uC6A9\uD558\uB294 \uC11C\uBE44\uC2A4 \uC774\uB984\uC785\uB2C8\uB2E4.\t\uD574\uB2F9
    \uC11C\uBE44\uC2A4\uB97C \uC6B4\uC601\uD558\uB294 \uD68C\uC0AC \uC774\uB984\uC785\uB2C8\uB2E4.\t\uC81C\uACF5\uD558\uB294
    \uAC1C\uC778\uC815\uBCF4\uC758 \uD56D\uBAA9\uC785\uB2C8\uB2E4.\r\n\r\n\r\n5.
    \uAC1C\uC778\uC815\uBCF4 \uD30C\uAE30\r\n\uAC1C\uBC1C\uD300\uC740 \uAC1C\uC778\uC815\uBCF4
    \uBCF4\uC720\uAE30\uAC04\uC774 \uC9C0\uB0AC\uAC70\uB098, \uCC98\uB9AC\uBAA9\uC801
    \uB2EC\uC131 \uB4F1 \uAC1C\uC778\uC815\uBCF4\uAC00 \uBD88\uD544\uC694\uD558\uAC8C
    \uB418\uC5C8\uC744 \uB54C\uC5D0\uB294 \uC9C0\uCCB4\uC5C6\uC774 \uD574\uB2F9 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uD30C\uAE30\uD569\uB2C8\uB2E4.\r\n\r\n\r\n\uB2E4\uB9CC, \uAC1C\uC778\uC815\uBCF4
    \uC911 \uBCF8\uC778\uD655\uC778\uAC12(CI)\uC740 \uD68C\uC6D0\uD0C8\uD1F4 \uB610\uB294
    \uB3D9\uC758\uCCA0\uD68C \uC2DC\uC810\uC73C\uB85C\uBD80\uD130 15\uC77C\uAC04
    \uAE30\uC874 \uC800\uC7A5\uACF5\uAC04\uACFC \uAD6C\uBD84\uB41C \uBCC4\uB3C4\uC758
    \uC800\uC7A5\uACF5\uAC04\uC5D0 \uC62E\uACA8\uC11C \uB0B4\uBD80 \uC9C0\uCE68 \uBC0F
    \uAD00\uACC4 \uBC95\uB839\uC5D0 \uB530\uB77C \uC77C\uC815\uAE30\uAC04 \uB3D9\uC548
    \uC800\uC7A5\uD55C \uD6C4 \uD30C\uAE30\uB429\uB2C8\uB2E4. \uC774\uB54C \uBCC4\uB3C4
    \uC800\uC7A5\uB41C \uAC1C\uC778\uC815\uBCF4\uB294 \uC18C\uBE44\uC790\uC758 \uBD88\uB9CC
    \uBC0F \uBD84\uC7C1\uD574\uACB0\uC744 \uC704\uD55C \uBAA9\uC801 \uBC0F \uBC95\uB839\uC5D0
    \uC758\uD55C \uACBD\uC6B0\uB97C \uC81C\uC678\uD558\uACE0 \uC808\uB300 \uB2E4\uB978
    \uC6A9\uB3C4\uB85C \uC774\uC6A9\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n\uCD5C\uADFC
    1\uB144 \uAC04 \uC11C\uBE44\uC2A4 \uC774\uC6A9 \uAE30\uB85D\uC774 \uC5C6\uB294
    \uACC4\uC815\uC5D0 \uB300\uD558\uC5EC \uD734\uBA74\uACC4\uC815\uC73C\uB85C \uBD84\uB958\uD558\uACE0
    \uD574\uB2F9 \uACC4\uC815\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uBCC4\uB3C4\uB85C
    \uBD84\uB9AC\uBCF4\uAD00 \uD569\uB2C8\uB2E4.\r\n\r\n\uD734\uBA74\uACC4\uC815\uC740
    \uBCC4\uB3C4 \uBD84\uB9AC\uBCF4\uAD00\uB41C \uD6C4 4\uB144\uC774 \uC9C0\uB098\uBA74
    \uBCF5\uAD6C\uD560 \uC218 \uC5C6\uB294 \uBC29\uBC95\uC73C\uB85C \uD30C\uAE30\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n\uD30C\uAE30 \uBC29\uBC95\uC740 \uC804\uC790\uC801
    \uD30C\uC77C \uD615\uD0DC\uC778 \uACBD\uC6B0 \uBCF5\uC6D0\uC774 \uBD88\uAC00\uB2A5\uD55C
    \uBC29\uBC95\uC73C\uB85C \uC601\uAD6C\uC0AD\uC81C \uD569\uB2C8\uB2E4. \uB2E4\uB9CC
    \uAE30\uC220\uC801 \uD2B9\uC131\uC73C\uB85C \uC601\uAD6C\uC0AD\uC81C\uAC00 \uACE4\uB780\uD560
    \uACBD\uC6B0 \uC775\uBA85\uC815\uBCF4\uB85C \uCC98\uB9AC\uD558\uC5EC \uBCF5\uC6D0\uC774
    \uBD88\uAC00\uB2A5\uD558\uB3C4\uB85D \uC870\uCE58\uD569\uB2C8\uB2E4. \uC885\uC774\uC5D0
    \uCD9C\uB825\uB41C \uAC1C\uC778\uC815\uBCF4\uB294 \uBD84\uC1C4\uAE30\uB85C \uBD84\uC1C4\uD558\uAC70\uB098
    \uC18C\uAC01\uC744 \uD1B5\uD558\uC5EC \uD30C\uAE30\uD569\uB2C8\uB2E4.\r\n\r\n\r\n\r\n6.
    \uAC1C\uC778\uC815\uBCF4 \uC790\uB3D9\uC218\uC9D1 \uC7A5\uCE58\r\n\uAC1C\uBC1C\uD300\uC740
    \uAC1C\uC778\uC815\uBCF4\uB97C \uC790\uB3D9\uC73C\uB85C \uC218\uC9D1\uD558\uB294
    \uC7A5\uCE58\uB97C \uC124\uCE58\xB7\uC6B4\uC601\uD558\uACE0 \uC788\uC73C\uBA70,
    \uC774\uC6A9\uC790\uB294 \uC774\uB97C \uAC70\uBD80\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uCFE0\uD0A4\uB780
    \uC6F9\uC0AC\uC774\uD2B8\uB97C \uC6B4\uC601\uD558\uB294\uB370 \uC774\uC6A9\uB418\uB294
    \uC11C\uBC84\uAC00 \uC774\uC6A9\uC790\uC758 \uBE0C\uB77C\uC6B0\uC800\uC5D0 \uBCF4\uB0B4\uB294
    \uC544\uC8FC \uC791\uC740 \uD14D\uC2A4\uD2B8 \uD30C\uC77C\uB85C\uC11C \uC774\uC6A9\uC790\uC758
    \uCEF4\uD4E8\uD130\uC5D0 \uC800\uC7A5\uB429\uB2C8\uB2E4.\r\n\r\n\uD300SNOW\uB294
    \uCFE0\uD0A4\uB97C \uD1B5\uD574 \uC774\uC6A9\uC790\uAC00 \uC120\uD638\uD558\uB294
    \uC124\uC815 \uB4F1\uC744 \uC800\uC7A5\uD558\uC5EC \uC774\uC6A9\uC790\uC5D0\uAC8C
    \uBCF4\uB2E4 \uBE60\uB978 \uD658\uACBD\uC744 \uC9C0\uC6D0\uD558\uBA70, \uD3B8\uB9AC\uD55C
    \uC774\uC6A9\uC744 \uC704\uD574 \uC11C\uBE44\uC2A4 \uAC1C\uC120\uC5D0 \uD65C\uC6A9\uD569\uB2C8\uB2E4.
    \uC774\uB97C \uD1B5\uD574 \uC774\uC6A9\uC790\uB294 \uBCF4\uB2E4 \uC190\uC27D\uAC8C
    \uAC8C\uC784 \uBC0F \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD560 \uC218 \uC788\uAC8C
    \uB429\uB2C8\uB2E4. \uB610\uD55C \uD300SNOW\uB294 \uC5EC\uB7EC \uC11C\uBE44\uC2A4\uC758
    \uC811\uC18D \uBE48\uB3C4, \uBC29\uBB38 \uC2DC\uAC04, \uAC01\uC885 \uC774\uBCA4\uD2B8
    \uCC38\uC5EC \uC815\uB3C4, \uBC29\uBB38 \uD68C\uC218 \uB4F1\uC744 \uBD84\uC11D\uD558\uC5EC
    \uC774\uC6A9\uC790\uC758 \uCDE8\uD5A5\uACFC \uAD00\uC2EC\uBD84\uC57C\uB97C \uD30C\uC545\uD569\uB2C8\uB2E4.
    \uC774\uB97C \uBC14\uD0D5\uC73C\uB85C \uAD11\uACE0\uB97C \uD3EC\uD568\uD55C \uAC1C\uC778
    \uB9DE\uCDA4\uD615 \uC11C\uBE44\uC2A4\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.\r\n\r\n\r\n\uC774\uC6A9\uC790\uB294
    \uCFE0\uD0A4 \uC124\uCE58\uC5D0 \uB300\uD55C \uC120\uD0DD\uAD8C\uC744 \uAC00\uC9C0\uACE0
    \uC788\uC2B5\uB2C8\uB2E4. \uB530\uB77C\uC11C, \uC774\uC6A9\uC790\uB294 \uC6F9
    \uBE0C\uB77C\uC6B0\uC800\uC5D0\uC11C \uC635\uC158\uC744 \uC124\uC815\uD568\uC73C\uB85C\uC368
    \uBAA8\uB4E0 \uCFE0\uD0A4\uB97C \uD5C8\uC6A9\uD558\uAC70\uB098, \uCFE0\uD0A4\uAC00
    \uC800\uC7A5\uB420 \uB54C\uB9C8\uB2E4 \uD655\uC778\uC744 \uAC70\uCE58\uAC70\uB098,
    \uBAA8\uB4E0 \uCFE0\uD0A4\uC758 \uC800\uC7A5\uC744 \uAC70\uBD80\uD560 \uC218\uB3C4
    \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uCFE0\uD0A4 \uC124\uCE58\uB97C \uAC70\uBD80\uD560
    \uACBD\uC6B0 \uC6F9 \uC0AC\uC6A9\uC774 \uBD88\uD3B8\uD574\uC9C0\uBA70 \uB85C\uADF8\uC778\uC774
    \uD544\uC694\uD55C \uC77C\uBD80 \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC5D0 \uC5B4\uB824\uC6C0\uC774
    \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\r\n[\uCFE0\uD0A4 \uC124\uC815
    \uD5C8\uC6A9 \uC5EC\uBD80 \uC9C0\uC815\uD558\uB294 \uBC29\uBC95]\r\nChrome\r\n(PC)
    \uC6F9\uBE0C\uB77C\uC6B0\uC800 \uC6B0\uCE21 \uC0C1\uB2E8 \uBA54\uB274\uC5D0\uC11C
    [\uC124\uC815] \uC120\uD0DD > [\uAC1C\uC778\uC815\uBCF4 \uBC0F \uBCF4\uC548]
