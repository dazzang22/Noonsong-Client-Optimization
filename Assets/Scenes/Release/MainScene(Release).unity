    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uC804\uACF5 \uB208\uC1A1\uC774\uC640 \uCE5C\uD574\uC9C8 \uC218\uB85D
    \uB208\uC1A1\uC774\uC758 \uC774\uC57C\uAE30\uAC00 \uD574\uAE08\uB429\uB2C8\uB2E4!\r\n\n2.
    \uB3C4\uAC10\uC5D0\uC11C \uB208\uC1A1\uC774\uB97C \uD074\uB9AD\uD558\uBA74 \uD574\uB2F9
    \uB208\uC1A1\uC774\uC640\uC758 \uCE5C\uBC00\uB3C4\uB97C \uCE5C\uBC00\uB3C4 \uACB0\uC815\uC758
    \uAC1C\uC218\uB85C \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694.\r\n\n3. \uD55C
    \uBC88 \uCE5C\uBC00\uB3C4 \uACB0\uC815\uC744 \uBAA8\uB450 \uCC44\uC6B0\uBA74
    \uBB34\uC9C0\uAC1C\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294 \uACB0\uC815\uC744 \uB2E4\uC2DC
    \uCC44\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\n4. \uBB34\uC9C0\uAC1C\uBE5B\uC758
    \uCE5C\uBC00\uB3C4 \uACB0\uC815\uC744 \uBAA8\uB450 \uCC44\uC6B0\uBA74 \uC88B\uC740
    \uC77C\uC774 \uC77C\uC5B4\uB0A0\uC9C0\uB3C4\u2026?!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dddb07847fa14284dbbbdfd0e5a1872f, type: 2}
