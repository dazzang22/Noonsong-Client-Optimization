    \uAD8C\uB9AC\uC5D0 \uC911\uB300\uD55C \uBCC0\uACBD\uC774 \uBC1C\uC0DD\uD560 \uB54C\uC5D0\uB294
    \uCD5C\uC18C 30\uC77C \uC804\uC5D0 \uC54C\uB824\uB4DC\uB9BD\uB2C8\uB2E4.\r\n\r\n\uC774
