  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \uD29C\uB9AC\uC758 \uC5F0\uAD6C\uC2E4\uC5D0\uC11C\uB294 \uB208\uC758
    \uACB0\uC815\uC744 \uC774\uC6A9\uD574 \uB208\uC1A1\uC774\uC5D0\uAC8C \uC120\uBB3C\uD560
    \uC218 \uC788\uB294 \uC544\uC774\uD15C\uC744 \uAD6C\uB9E4\uD560 \uC218 \uC788\uC5B4\uC694.\r\n\n2.
    \uC804\uACF5 \uB208\uC1A1\uC774\uC5D0 \uB530\uB77C \uC88B\uC544\uD558\uB294 \uC544\uC774\uD15C\uC774
    \uB2E4\uB974\uB2C8, \uC801\uC808\uD55C \uC544\uC774\uD15C\uC744 \uAD6C\uB9E4\uD574
