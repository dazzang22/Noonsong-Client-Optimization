    182 (ecrm.cyber.go.kr)\r\n\r\n\r\n11. \uAC1C\uC778\uC815\uBCF4 \uC5F4\uB78C\uCCAD\uAD6C
    \uB2F4\uB2F9\uBD80\uC11C\r\n\uC774\uC6A9\uC790\uB294 \uB2E4\uC74C\uAC8C\uC784
    \uD648\uD398\uC774\uC9C0 \uB0B4  \u2018\uB0B4 \uC815\uBCF4 \uAD00\uB9AC\u2019
    \uB610\uB294 \u2018\uACE0\uAC1D\uC13C\uD130\u2019\uB97C \uD1B5\uD574 \uBCF8\uC778\uD655\uC778\uC808\uCC28\uB97C
    \uAC70\uCE5C \uD6C4 \uC9C1\uC811 \uC5F4\uB78C\u2219 \uC218\uC815\uC774 \uAC00\uB2A5\uD558\uBA70
