        \uBCF4\uD638\uD568\uC73C\uB85C\uC368 \uC774\uC6A9\uC790\uAC00 \uC548\uC2EC\uD558\uACE0
        \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD560 \uC218 \uC788\uB3C4\uB85D \uD300SNOW\uAC00
        \uC900\uC218\uD574\uC57C \uD560 \uC9C0\uCE68\uC744 \uC758\uBBF8\uD569\uB2C8\uB2E4.\r\n\r\n\uBCF8
